# Server Port
PORT=5000
NODE_ENV=development

# LLM Providers (Optional - System automatically uses built-in high-accuracy NLP fallback if not provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-1.5-flash

# WhatsApp Cloud API Configuration
# Webhook verification secret token configured in Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=quantum_weave_secret_verify_2026

# Meta Graph API Access Token (for live WhatsApp outbound messaging)
WHATSAPP_API_TOKEN=

# Meta Phone Number ID (e.g., from WhatsApp Business Cloud API App)
WHATSAPP_PHONE_NUMBER_ID=104829102948192

# External Automation Notification Webhooks (Optional)
# Dispatches real-time alerts to Slack/Discord/Custom webhook when leads are qualified
SLACK_WEBHOOK_URL=
TEAM_NOTIFICATION_EMAIL=leads@quantumweave.ai
